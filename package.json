{
  "name": "select-line-without-newline",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.3",
  "publisher": "dai",
  "license": "MIT",
  "homepage": "https://github.com/dai/triclick#readme",
  "bugs": {
    "url": "https://github.com/dai/triclick/issues"
  },
  "keywords": [
    "selection",
    "newline",
    "triple-click",
    "copy"
  ],
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22.12.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dai/triclick"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "selectLineWithoutNewline.toggleEnabled",
        "title": "%command.toggleEnabled.title%"
      },
      {
        "command": "selectLineWithoutNewline.selectLine",
        "title": "%command.selectLine.title%"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "selectLineWithoutNewline.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.enabled.description%"
        },
        "selectLineWithoutNewline.handleMultiLine": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.handleMultiLine.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "pretest:unit": "npm run compile",
    "test:unit": "mocha --ui tdd ./out/test/suite/selectionAdjuster.test.js",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package --no-git-tag-version",
    "lint": "eslint src"
  },
  "overrides": {
    "mocha": {
      "diff": "^8.0.3",
      "serialize-javascript": "^7.0.5"
    }
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "26.x",
    "@types/vscode": "1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.13.0",
    "glob": "^13.0.6",
    "mocha": "^11.8.0",
    "typescript": "^5.4.5"
  },
  "icon": "icon.png"
}
